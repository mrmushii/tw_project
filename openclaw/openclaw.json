// OpenClaw config template — SECRETS-FREE, safe to commit.
//
// Copy to ~/.openclaw/openclaw.json for local use, or let the Docker image mount
// it at the path given by OPENCLAW_CONFIG_PATH.
//
// Every credential is supplied by environment variable, never inlined here:
//   ANTHROPIC_AUTH_TOKEN  - Claude Pro token from `claude setup-token`
//   TELEGRAM_BOT_TOKEN    - from @BotFather (env fallback works for the default account)
//   GITHUB_TOKEN          - PAT with `repo` scope, used by the github-notify skill
//   GITHUB_REPO           - "owner/name" to watch
{
  // Without an explicit gateway.mode the gateway refuses to start ("existing
  // config is missing gateway.mode ... treat this as suspicious or clobbered
  // config") and Render's deploy exits 78 before binding a port.
  gateway: {
    mode: "local",

    // MUST be set explicitly. OpenClaw only defaults to bind=auto (0.0.0.0) when
    // it detects a container environment, and that detection does NOT fire on
    // Render — the first deploy came up healthy but bound to localhost, so
    // Render's port scan found nothing and timed out ("Detected open ports on
    // localhost -- did you mean to bind one of these to 0.0.0.0?").
    bind: "auto",

    // Required: OpenClaw refuses to bind a non-loopback address without auth.
    // The token comes from OPENCLAW_GATEWAY_TOKEN (generated by render.yaml),
    // never hardcoded here. If that variable is missing the gateway generates a
    // throwaway token per startup, which works but changes on every restart.
    auth: {
      mode: "token",
    },
  },

  agents: {
    defaults: {
      // Haiku throughout — required for this project. Cheapest and fastest;
      // adequate for scheduling, summarising, and the image-classification task.
      model: {
        primary: "anthropic/claude-haiku-4-5",
      },

      // Baked into the image by the Dockerfile, deliberately NOT under the state
      // dir: the state dir is wiped on every Render restart, which would strip the
      // agent's persona (IDENTITY.md / SOUL.md / USER.md) along with it.
      workspace: "/app/workspace",
    },
  },

  channels: {
    telegram: {
      enabled: true,
      // botToken intentionally omitted — read from TELEGRAM_BOT_TOKEN.
      // Long polling is the default transport, so no inbound webhook is needed.
      // That is what makes this work on Render's free tier.
      dmPolicy: "pairing",
      groups: { "*": { requireMention: true } },

      // Suppress the per-tool progress messages. By default OpenClaw streams a
      // line per tool call into the chat, including the raw command text, so a
      // simple question arrives buried under several "Exec" lines. Turning off
      // `toolProgress` leaves normal text streaming intact — the reply still
      // appears progressively, which matters because an agent turn takes
      // 20-50s and total silence reads as a hung bot during a live demo.
      // `commandText: "status"` is belt-and-braces: if a progress line is ever
      // emitted, it shows a status label instead of the raw shell command.
      streaming: {
        preview: { toolProgress: false },
        progress: { toolProgress: false, commandText: "status" },
      },
    },
  },

  skills: {
    load: {
      // Custom skills live beside this file; the image copies them to /app/skills.
      extraDirs: ["/app/skills"],
    },
  },
}
