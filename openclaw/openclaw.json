// OpenClaw config template — SECRETS-FREE, safe to commit.
//
// Copy to ~/.openclaw/openclaw.json for local use, or let the Docker image mount
// it at the path given by OPENCLAW_CONFIG_PATH.
//
// Every credential is supplied by environment variable, never inlined here:
//   ANTHROPIC_AUTH_TOKEN  - Claude Pro token from `claude setup-token`
//   TELEGRAM_BOT_TOKEN    - from @BotFather (env fallback works for the default account)
//   GITHUB_TOKEN          - PAT with `repo` scope, used by the github-notify skill
//   GITHUB_REPO           - "owner/name" to watch
{
  // Without an explicit gateway.mode the gateway refuses to start ("existing
  // config is missing gateway.mode ... treat this as suspicious or clobbered
  // config") and Render's deploy exits 78 before binding a port.
  gateway: {
    mode: "local",

    // "lan" is the only mode that returns 0.0.0.0 unconditionally, which is what
    // Render's port scan requires.
    //
    // Do NOT use "auto" here. It still gates on container detection, which looks
    // for /.dockerenv, /run/.containerenv or docker/kubepods markers in
    // /proc/1/cgroup — none of which match Render's runtime. On Render "auto"
    // falls through to 127.0.0.1, the gateway comes up perfectly healthy, and the
    // deploy then dies on "Detected open ports on localhost". Cost two deploys.
    //
    // "lan" is a slight misnomer for a cloud host; it means "all interfaces".
    // Binding all interfaces is why gateway.auth.mode below is mandatory.
    bind: "lan",

    // Required: OpenClaw refuses to bind a non-loopback address without auth.
    // The token comes from OPENCLAW_GATEWAY_TOKEN (generated by render.yaml),
    // never hardcoded here. If that variable is missing the gateway generates a
    // throwaway token per startup, which works but changes on every restart.
    auth: {
      mode: "token",
    },
  },

  agents: {
    defaults: {
      // Haiku throughout — required for this project. Cheapest and fastest;
      // adequate for scheduling, summarising, and the image-classification task.
      model: {
        primary: "anthropic/claude-haiku-4-5",
      },

      // Baked into the image by the Dockerfile, deliberately NOT under the state
      // dir: the state dir is wiped on every Render restart, which would strip the
      // agent's persona (IDENTITY.md / SOUL.md / USER.md) along with it.
      workspace: "/app/workspace",
    },
  },

  channels: {
    telegram: {
      enabled: true,
      // botToken intentionally omitted — read from TELEGRAM_BOT_TOKEN.
      // Long polling is the default transport, so no inbound webhook is needed.
      // That is what makes this work on Render's free tier.
      // "allowlist" rather than "pairing" on purpose. `pairing approve` writes the
      // approved sender to a STORE under the state dir, and Render's free tier has
      // no persistent disk — so a paired instance forgets the pairing on every
      // restart, and the bot goes silent until someone re-pairs by hand. An
      // allowlist in config is baked into the image and survives every restart.
      //
      // The trade-off: this is the owner's Telegram user id in a public repo. It
      // is not a secret (you cannot message someone from their numeric id alone),
      // but it is identifying. Move it to an env var if that matters.
      dmPolicy: "allowlist",
      allowFrom: ["telegram:5235029766"],

      groups: { "*": { requireMention: true } },

      // Suppress the per-tool progress messages. By default OpenClaw streams a
      // line per tool call into the chat, including the raw command text, so a
      // simple question arrives buried under several "Exec" lines. Turning off
      // `toolProgress` leaves normal text streaming intact — the reply still
      // appears progressively, which matters because an agent turn takes
      // 20-50s and total silence reads as a hung bot during a live demo.
      // `commandText: "status"` is belt-and-braces: if a progress line is ever
      // emitted, it shows a status label instead of the raw shell command.
      streaming: {
        preview: { toolProgress: false },
        progress: { toolProgress: false, commandText: "status" },
      },
    },
  },

  // Render's free tier gives roughly 0.1 of a CPU core and 512 MB RAM. With the
  // default plugin set the gateway logged eventLoopDelayMaxMs over 20000 and
  // cpuCoreRatio 0.13 — turns started but never finished. None of these plugins
  // are used by reminders, the briefing, or GitHub notifications, and `browser`
  // additionally spawns its own browser-control server.
  //
  // Kept: telegram (the channel), memory-core (reminders), device-pair.
  plugins: {
    deny: [
      "browser",
      "canvas",
      "file-transfer",
      "phone-control",
      "talk-voice",
      "ollama",
    ],
  },

  // Owner for privileged commands. Also lost with the state dir if left to the
  // pairing flow, so it is pinned here for the same reason as the allowlist above.
  commands: {
    ownerAllowFrom: ["telegram:5235029766"],
  },

  skills: {
    load: {
      // The image copies custom skills to /app/workspace/skills, matching the local
      // layout (~/.openclaw/workspace/skills). Workspace skills are normally
      // auto-discovered, so this is belt-and-braces — but it costs nothing and
      // guarantees the skill loads even if discovery is keyed off the state dir
      // rather than the configured workspace.
      extraDirs: ["/app/workspace/skills"],
    },
  },
}
