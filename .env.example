# Copy this file to .env and fill in ONE of the two options below.
# .env is gitignored — never commit it.
#
# Set exactly one. If both are present the API rejects the request; the classify
# script will ignore the API key when a subscription token is set.

# Option A — Claude Pro/Max subscription (no per-token billing).
# Generate with:  claude setup-token
ANTHROPIC_AUTH_TOKEN=sk-ant-oat01-your-token-here

# Option B — pay-per-token API key from https://console.anthropic.com/
# ~$0.35 for all 216 test images on claude-haiku-4-5.
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
